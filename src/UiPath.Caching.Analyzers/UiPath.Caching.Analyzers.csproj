<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shipped inside the UiPath.Caching.Abstractions package (analyzers/dotnet/cs), not as a package of its own.
       Microsoft.CodeAnalysis.CSharp 4.8 is the compiler of the .NET 8 SDK, the oldest one the library supports. -->
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <Description>Analyzers for UiPath.Caching</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="UiPath.Caching.Analyzers.CodeFixes" />
    <InternalsVisibleTo Include="UiPath.Caching.Analyzers.Tests" />
  </ItemGroup>
</Project>
