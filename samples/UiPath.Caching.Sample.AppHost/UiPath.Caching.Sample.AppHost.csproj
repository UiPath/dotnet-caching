<Project Sdk="Aspire.AppHost.Sdk/13.6.5">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAspireHost>true</IsAspireHost>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
    <!-- Aspire.AppHost.Sdk 13.6.5 calls the SDK's PickBestRid task on any 10.0.100+ SDK, but 10.0.4xx lacks it (MSB4036).
         Use the RID tool it falls back to instead. -->
    <_AspireUseSdkPickBestRid>false</_AspireUseSdkPickBestRid>
    <SonarQubeExclude>true</SonarQubeExclude>
    <SonarQubeTestProject>false</SonarQubeTestProject>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <UserSecretsId>7c62f7b0-e089-4996-a952-d0ac77462eee</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Redis" />
    <PackageReference Include="MessagePack" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UiPath.Caching.Sample\UiPath.Caching.Sample.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="$(SolutionDir)\GlobalAssemblyInfo.cs" />
  </ItemGroup>

</Project>
