<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <LangVersion>13.0</LangVersion>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
  </PropertyGroup>
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <PropertyGroup>
    <AssemblyName>$(MSBuildProjectName)</AssemblyName>
    <RootNamespace>$(AssemblyName)</RootNamespace>
    <PackageId>$(AssemblyName)</PackageId>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NeutralLanguage>en</NeutralLanguage>
    <Authors>UiPath</Authors>
    <Company>UiPath</Company>
    <Product>UiPath Caching</Product>
    <Copyright>Copyright © $([System.DateTime]::Now.Year) UiPath, Inc.</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>UiPath Caching</Description>
    <PackageTags>Caching</PackageTags>
    <PackageProjectUrl>https://github.com/UiPath/dotnet-caching</PackageProjectUrl>
    <RepositoryUrl>https://github.com/UiPath/dotnet-caching</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageOutputPath>$(MSBuildThisFileDirectory)Release</PackageOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <NoWarn>$(NoWarn);NU5105;NU1507;CS1591;AD0001;NU1900;</NoWarn>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	  <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <SonarQubeExclude>false</SonarQubeExclude>
    <SonarQubeTestProject>false</SonarQubeTestProject>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(SolutionDir)\GlobalAssemblyInfo.cs">
      <Link>Properties/GlobalAssemblyInfo.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <!-- StyleCop is here for the ordering rules and SA1402 (one top-level type per file, src only).
       Everything else it ships is switched off by category in .editorconfig. -->
  <ItemGroup>
    <PackageReference Include="StyleCop.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)stylecop.json" Link="stylecop.json" />
  </ItemGroup>
  <!-- The SonarCloud rules at build time, so the CI build fails on them before the PR analysis does.
       SonarAnalyzer.CSharp 10.x is under the Sonar Source-Available License, which the FOSSA policy flags. It is a
       build-time analyzer (PrivateAssets=all) and never ships in our packages, so the FOSSA job restores with
       -p:UseSonarAnalyzer=false to keep it out of the scanned dependency graph. -->
  <ItemGroup Condition="'$(UseSonarAnalyzer)' != 'false'">
    <PackageReference Include="SonarAnalyzer.CSharp">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <!-- UIPCACHE001 on src and samples (a warning, .editorconfig); these references also build the analyzers before
       UiPath.Caching.Abstractions packs them. -->
  <ItemGroup Condition="'$(IsRoslynComponent)' != 'true' And ($([MSBuild]::MakeRelative('$(MSBuildThisFileDirectory)', '$(MSBuildProjectDirectory)').StartsWith('src')) Or $([MSBuild]::MakeRelative('$(MSBuildThisFileDirectory)', '$(MSBuildProjectDirectory)').StartsWith('samples')))">
    <ProjectReference Include="$(MSBuildThisFileDirectory)src/UiPath.Caching.Analyzers/UiPath.Caching.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" IsAspireProjectResource="false" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)src/UiPath.Caching.Analyzers.CodeFixes/UiPath.Caching.Analyzers.CodeFixes.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" IsAspireProjectResource="false" />
  </ItemGroup>
</Project>
